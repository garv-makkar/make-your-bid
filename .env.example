# Supabase transaction pooler (port 6543): application/runtime traffic.
DATABASE_URL="postgresql://prisma.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Supabase session pooler (port 5432): Prisma migrations and admin commands.
DIRECT_URL="postgresql://prisma.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
